{
  "name": "fledge-plugin-discord",
  "version": "0.2.0",
  "description": "Discord webhook plugin for Fledge — send messages and receive incoming webhooks",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./discord": "./src/discord.ts",
    "./verify": "./src/verify.ts",
